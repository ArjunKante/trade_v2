# Angel One SmartAPI credentials for src/fibo/ (Fibonacci/ORB intraday research).
# Copy this file to .env and fill in the real values. .env is git-ignored
# (see .gitignore) -- never commit it, never fill in real values here.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Gmail SMTP app password for the Fibo live jobs' email alerts
# (src/fibo_live/notify.py) -- NOT your real Gmail password. Generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be on). FIBO_EMAIL_FROM and FIBO_EMAIL_TO can be the same address.
FIBO_EMAIL_FROM=
FIBO_EMAIL_APP_PASSWORD=
FIBO_EMAIL_TO=
