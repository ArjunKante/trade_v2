# Angel One SmartAPI credentials for src/fibo/ (Fibonacci/ORB intraday research).
# Copy this file to .env and fill in the real values. .env is git-ignored
# (see .gitignore) -- never commit it, never fill in real values here.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Gmail SMTP app password for the Fibo live jobs' email alerts
# (src/fibo_live/notify.py) -- NOT your real Gmail password. Generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be on). FIBO_EMAIL_FROM and FIBO_EMAIL_TO can be the same address.
FIBO_EMAIL_FROM=
FIBO_EMAIL_APP_PASSWORD=
FIBO_EMAIL_TO=

# healthchecks.io dead-man's-switch ping URL for scripts/fibo_evening.py
# (src/fibo_live/heartbeat.py). Create the check at healthchecks.io,
# cron schedule "30 18 * * 1-5", timezone Asia/Kolkata, grace 1 hour.
FIBO_EVENING_HEALTHCHECK_URL=

# healthchecks.io dead-man's-switch ping URL for scripts/snapshot_options_depth.py
# (src/options_depth/heartbeat.py). Cron schedule "30 10,12,14 * * 1-5",
# timezone Asia/Kolkata, grace 30 minutes.
OPTIONS_DEPTH_HEALTHCHECK_URL=
